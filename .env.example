# Database Configuration (Neon PostgreSQL with pgvector)
# DATABASE_URL: Pooled connection URL (used by the application at runtime with connection pooling)
DATABASE_URL="postgresql://neondb_owner:your-neon-password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct connection URL (used by Prisma CLI for migrations, introspection, and schema operations)
DIRECT_URL="postgresql://neondb_owner:your-neon-password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session Security (32+ character random string)
SESSION_SECRET="your-32-character-session-secret-here"

# AI Provider Keys (Can also be managed securely in Admin UI)
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"

# Local Whisper Speech-to-Text Microservice
# WHISPER_ENV: "development" | "production"
WHISPER_ENV="development"
WHISPER_SERVICE_URL="http://127.0.0.1:8000"
# WHISPER_API_SECRET: Shared secret between Next.js and Whisper service.
# Required in ALL environments (both development and production).
# Generate a strong 32-byte hex secret using:
#   openssl rand -hex 32
#   or in Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHISPER_API_SECRET=
WHISPER_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# SMTP Email Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@example.com"

# Backblaze B2 S3-Compatible Private Object Storage
B2_S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_BUCKET_NAME="your-private-b2-bucket"
B2_KEY_ID="your-b2-key-id"
B2_APPLICATION_KEY="your-b2-application-key"
