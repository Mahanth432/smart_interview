generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id            Int                @id @default(autoincrement())
  username      String             @unique
  email         String?            @unique
  name          String?
  passwordHash  String?
  role          String             @default("INTERVIEWER")
  emailVerified       Boolean              @default(false)
  tokenVersion        Int                  @default(1)
  createdAt     DateTime           @default(now())
  documents     Document[]
  sessions      InterviewSession[]
  auditLogs     AuditLog[]
  candidate     Candidate?
  otps          OtpVerification[]
  uploadIntents       UploadIntent[]
  passwordResetTokens PasswordResetToken[]
}

enum DocumentStorageStatus {
  AVAILABLE
  MISSING
}

enum UploadIntentStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

model Document {
  id               Int             @id @default(autoincrement())
  name             String
  originalFilename String
  fileType         String
  fileSize         Int
  storagePath      String
  status             String
  storageStatus      DocumentStorageStatus @default(AVAILABLE)
  missingAt          DateTime?
  lastStorageCheckAt DateTime?
  contentEtag        String?
  userId           Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  branch           String?
  institution      String?
  semester         String?
  subject          String?
  /// ADMIN_MASTER | INTERVIEWER_PRIVATE | SYNCED_FROM_ADMIN
  docSource        String          @default("INTERVIEWER_PRIVATE")
  /// For SYNCED_FROM_ADMIN docs: references the original admin Document.id
  adminDocId       Int?
  user             User            @relation(fields: [userId], references: [id])
  chunks           DocumentChunk[]

  @@index([userId])
  @@index([subject])
  @@index([docSource])
  @@index([adminDocId])
  @@index([storageStatus])
  @@index([storagePath])
}

model AppSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model DocumentChunk {
  id         Int                    @id @default(autoincrement())
  documentId Int
  content    String
  chunkIndex Int
  createdAt  DateTime               @default(now())
  embedding  Unsupported("vector")?
  pageNumber Int?
  sourceType String?
  topic      String?
  unit       String?
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
  @@index([topic])
}

model Candidate {
  id        String             @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime           @default(now())
  sessions  InterviewSession[]
  userId    Int?               @unique
  user           User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile        CandidateProfile?
  conceptMastery CandidateConceptMastery[]
  revisions      RevisionRecommendation[]
}

model InterviewSession {
  id            String           @id @default(uuid())
  candidateId   String
  interviewerId Int?
  status        String           @default("active")
  difficulty    String           @default("medium")
  interviewType String
  scope              Json?
  pendingSuggestions Json?
  pausedAt           DateTime?
  score         Float?
  topicsCovered String[]
  weakTopics    String[]
  strongTopics  String[]
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  report        InterviewReport?
  candidate     Candidate        @relation(fields: [candidateId], references: [id])
  interviewer   User?            @relation(fields: [interviewerId], references: [id])
  gaps          KnowledgeGap[]
  questions     Question[]

  @@index([candidateId])
  @@index([interviewerId])
  @@index([status])
}

model Question {
  id               String           @id @default(uuid())
  sessionId        String
  questionNumber   Int
  content          String
  type             String
  difficulty       String
  topic            String?
  expectedAnswer   String?
  coreConcepts     String[]
  requiredKeywords String[]
  sourceReferences Json?
  askedAt          DateTime         @default(now())
  answer           Answer?
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Answer {
  id         String            @id @default(uuid())
  questionId String            @unique
  transcript String
  audioPath  String?
  duration   Int?
  answeredAt DateTime          @default(now())
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluation AnswerEvaluation?
}

model AnswerEvaluation {
  id                String   @id @default(uuid())
  answerId          String   @unique
  score             Float
  correctness       String
  completeness      String
  relevance         String
  technicalAccuracy String
  mentionedKeywords String[]
  missingKeywords   String[]
  correctConcepts   String[] @default([])
  missingConcepts   String[] @default([])
  incorrectConcepts String[] @default([])
  reasoningQuality      String   @default("")
  communicationScore    Float?
  communicationFeedback String   @default("")
  feedback          String
  answer            Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

model KnowledgeGap {
  id         String           @id @default(uuid())
  sessionId  String
  concept    String
  confidence String
  evidence   String
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model InterviewReport {
  id               String           @id @default(uuid())
  sessionId        String           @unique
  overallScore     Float
  topicScores      Json
  strengths        String[]
  weaknesses       String[]
  executiveSummary String
  improvementPlan    String
  aiExecutiveSummary String?
  aiStrengths        String[]         @default([])
  aiWeaknesses       String[]         @default([])
  aiImprovementPlan  String?
  interviewerNotes   String?
  editedByUserId     Int?
  editedByName       String?
  editedAt           DateTime?
  createdAt        DateTime         @default(now())
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     Int?
  username   String?
  action     String
  entityType String?
  entityId   String?
  status     String   @default("SUCCESS")
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

model OtpVerification {
  id        String    @id @default(uuid())
  userId    Int?
  email     String
  otpHash   String
  purpose   String    @default("EMAIL_VERIFICATION")
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}



model UploadIntent {
  id               String             @id @default(uuid())
  userId           Int
  docSource        String
  storagePath      String             @unique
  originalFilename String
  mimeType         String
  expectedSize     Int
  subject          String?
  status           UploadIntentStatus @default(PENDING)
  documentId       Int?
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    Int
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CandidateProfile {
  id                  String    @id @default(uuid())
  candidateId         String    @unique
  answeringStyle      String    @default("")
  reasoningPattern    String    @default("")
  technicalStrengths  String[]  @default([])
  communicationTraits String[]  @default([])
  learningPreferences String[]  @default([])
  totalEvaluations    Int       @default(0)
  averageScore        Float?
  lastAnalyzedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateConceptMastery {
  id                  String    @id @default(uuid())
  candidateId         String
  conceptKey          String
  conceptName         String
  subject             String    @default("General")
  masteryScore        Float     @default(0)
  attemptCount        Int       @default(0)
  weaknessCount       Int       @default(0)
  lastScore           Float?
  lastTestedAt        DateTime  @default(now())
  forgettingRisk      Float     @default(0)
  recommendedReviewAt DateTime?
  linkedDocumentId    Int?
  linkedDocumentName  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, conceptKey])
  @@index([candidateId])
  @@index([candidateId, forgettingRisk])
  @@index([candidateId, weaknessCount])
}

model RevisionRecommendation {
  id                 String    @id @default(uuid())
  candidateId        String
  conceptName        String
  subject            String    @default("General")
  priorityScore      Float
  forgettingRisk     Float     @default(0)
  reason             String
  linkedDocumentId   Int?
  linkedDocumentName String?
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([candidateId, priorityScore])
}
